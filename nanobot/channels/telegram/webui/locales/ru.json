          "allowlist": "Разрешенный список"
        }
      },
      "mode": {
        "label": "Режим подключения",
        "choices": {
          "polling": "Долгое опрос",
          "webhook": "Webhook"
        }
      },
      "replyToMessage": {
        "label": "Ответ на сообщение",
        "choices": {
          "true": "Включено",
          "false": "Выключено"
        }
      },
      "reactEmoji": {
        "label": "Читать эмодзи"
      },
